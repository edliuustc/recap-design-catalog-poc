{
  "title": "Recap design release",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "status", "designs"],
  "properties": {
    "schemaVersion": {"const": "recap-design-release/1.0"},
    "id": {"type": "string", "pattern": "^v(?!000)[0-9]{3}$"},
    "status": {"const": "approved"},
    "designs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "sha256"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
          "path": {
            "type": "string",
            "pattern": "^designs/[a-z][a-z0-9-]{0,63}/design\\.json$"
          },
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
