{
  "title": "Recap per-form component guidance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "status",
    "form",
    "renderGuidance"
  ],
  "properties": {
    "schemaVersion": {"const": "recap-component/2.0"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "version": {
      "type": "string",
      "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"
    },
    "status": {"const": "approved"},
    "form": {
      "enum": [
        "decision",
        "comparison",
        "ideation",
        "sequence",
        "tasks",
        "status_table",
        "set",
        "findings",
        "metrics",
        "route",
        "qa",
        "open_questions",
        "points"
      ]
    },
    "renderGuidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "prompt"],
      "properties": {
        "description": {"type": "string", "minLength": 1, "maxLength": 4000},
        "prompt": {"type": "string", "minLength": 1, "maxLength": 4000},
        "referenceImage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["assetId", "alt"],
          "properties": {
            "assetId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "alt": {"type": "string", "minLength": 1, "maxLength": 240}
          }
        }
      }
    }
  }
}
